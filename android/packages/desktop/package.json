{
  "name": "@getpaseo/desktop",
  "version": "0.11.4",
  "private": true,
  "description": "PaseoDog desktop app (Electron wrapper)",
  "homepage": "https://github.com/moveju112/paseodog",
  "license": "Apache-2.0",
  "author": {
    "name": "PaseoDog",
    "email": "hello@paseodog.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moveju112/paseodog.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "npm --prefix ../.. run build:desktop-deps && npm run build:package --",
    "build:package": "npm run build:main && electron-builder --config electron-builder.cjs",
    "build:main": "tsc -p tsconfig.json && node ../../../scripts/patch-windows-installer.mjs dist/installer.nsi",
    "capture-harness": "npm run build:main && ./capture-harness/run.sh",
    "dev": "./scripts/dev.sh",
    "dev:win": "powershell ./scripts/dev.ps1",
    "test:e2e:renderer": "cross-env E2E_DESKTOP_RUNTIME=1 playwright test --config=playwright.config.ts --project=desktop",
    "test:e2e:browser-tabs": "npm run build:main && node ./e2e/browser-tabs.e2e.mjs",
    "verify:electron-cdp": "node ./scripts/verify-electron-cdp.mjs",
    "test": "install-electron && vitest run --exclude \"e2e/**\"",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test:e2e:lifecycle": "npm run build:main && node ./e2e/daemon-lifecycle.e2e.mjs"
  },
  "dependencies": {
    "@getpaseo/cli": "*",
    "@getpaseo/server": "*",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "ws": "^8.14.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "24.6.0",
    "@types/ws": "^8.5.14",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3",
    "unzip-crx-3": "^0.2.0",
    "vitest": "^4.1.6",
    "wait-on": "8.0.5"
  },
  "desktopName": "PaseoDog.desktop"
}
